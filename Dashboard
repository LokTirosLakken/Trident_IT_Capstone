    private void sendOverdueReminders() {
        List<String> targets = new ArrayList<>();
        for (int r = 0; r < watchlistModel.getRowCount(); r++) {
            boolean checked = Boolean.TRUE.equals(watchlistModel.getValueAt(r, 0));
            String status = String.valueOf(watchlistModel.getValueAt(r, 7));
            if (checked || "Overdue".equalsIgnoreCase(status)) {
                targets.add(watchlistModel.getValueAt(r, 3) + " (" + watchlistModel.getValueAt(r, 1) + ")");
            }
        }
        JOptionPane.showMessageDialog(this,
                "Queued automated email return reminders for:\n• " + String.join("\n• ", targets),
                "Overdue Reminders Dispatched",
                JOptionPane.INFORMATION_MESSAGE);
    }

    private void overrideSelectedRisk() {
        int row = watchlistTable.getSelectedRow();
        if (row < 0) {
            JOptionPane.showMessageDialog(this, "Click a row in the table first to adjust its risk level.");
            return;
        }
        String current = String.valueOf(watchlistModel.getValueAt(row, 6));
        String[] options = {"Low", "Medium", "High"};
        String choice = (String) JOptionPane.showInputDialog(
                this,
                "Manual Risk Override for " + watchlistModel.getValueAt(row, 1) + ":",
                "Adjust Asset Risk",
                JOptionPane.PLAIN_MESSAGE,
                null,
                options,
                current
        );
        if (choice != null && !choice.equals(current)) {
            watchlistModel.setValueAt(choice, row, 6);
            riskChart.repaint();
        }
    }

    private void openRiskCriteriaDialog() {
        JPanel panel = new JPanel(new GridLayout(3, 2, 10, 10));
        panel.add(new JLabel("High Risk Overdue Threshold (Days):"));
