        int res = JOptionPane.showConfirmDialog(this, panel, "Configure Automated Risk Criteria", JOptionPane.OK_CANCEL_OPTION);
        if (res == JOptionPane.OK_OPTION) {
            JOptionPane.showMessageDialog(this, "Risk classification thresholds updated.");
        }
    }

    private void markSelectedAsDamaged() {
        int row = watchlistTable.getSelectedRow();
        if (row < 0) {
            JOptionPane.showMessageDialog(this, "Select an asset row to log damage or an RMA ticket.");
            return;
        }
        String assetId = String.valueOf(watchlistModel.getValueAt(row, 1));
        String note = JOptionPane.showInputDialog(this, "Enter damage description / RMA # for " + assetId + ":");
        if (note != null && !note.trim().isEmpty()) {
            watchlistModel.setValueAt("RMA: " + note.trim(), row, 5);
            watchlistModel.setValueAt("Maintenance", row, 7);
        }
    }

