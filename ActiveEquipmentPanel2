


import java.awt.*;
import java.util.*;
import javax.swing.*;
import javax.swing.event.*;
import javax.swing.table.*;

/** Active assignments: filters, reminders, bulk return and CSV export. */
public class ActiveEquipmentPanel extends JPanel {

    private final DefaultTableModel model;
    private final JTable table;

    public ActiveEquipmentPanel() {

        // Main Panel
        setLayout(new BorderLayout());
        setBackground(new Color(245, 247, 250));
        setBorder(BorderFactory.createEmptyBorder(26, 30, 26, 30));

        // Header
        JPanel header = new JPanel(new BorderLayout());
        header.setOpaque(false);

        JLabel title = new JLabel("Active Equipment");
        title.setFont(new Font("SansSerif", Font.BOLD, 28));

        JLabel description = new JLabel(
            "Assignments, due dates, reminders, and returns."
        );
        description.setForeground(new Color(100, 110, 120));

        JPanel titlePanel = new JPanel();
        titlePanel.setOpaque(false);
        titlePanel.setLayout(new BoxLayout(titlePanel, BoxLayout.Y_AXIS));
        titlePanel.add(title);
        titlePanel.add(Box.createVerticalStrut(5));
        titlePanel.add(description);

        header.add(titlePanel, BorderLayout.WEST);
        add(header, BorderLayout.NORTH);

        // Body
        JPanel body = new JPanel(new BorderLayout(0, 12));
        body.setOpaque(false);

        // Metrics
        JPanel metrics = new JPanel(new GridLayout(1, 4, 10, 0));
        metrics.setOpaque(false);

        metrics.add(metric("Assigned devices", "89"));
        metrics.add(metric("Assigned employees", "76"));
        metrics.add(metric("Overdue returns", "5"));
        metrics.add(metric("Pending returns", "12"));

        // Filters
        JPanel filters = new JPanel(new GridLayout(1, 4, 8, 0));
        filters.setOpaque(false);

        JTextField search = new JTextField();
        search.setFont(new Font("SansSerif", Font.PLAIN, 14));
        search.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(new Color(210, 215, 220)),
            BorderFactory.createEmptyBorder(10, 12, 10, 12)
        ));
        search.setToolTipText("Search asset, employee, or ID");

        JComboBox<String> dept = new JComboBox<>(
            new String[]{
                "All departments",
                "IT",
                "HR",
                "Finance",
                "Marketing",
                "Operations"
            }
        );

        JComboBox<String> type = new JComboBox<>(
            new String[]{
                "All device types",
                "Laptop",
                "Phone",
                "Monitor",
                "Accessory"
            }
        );

        JButton export = createButton("Export CSV", false);

        filters.add(search);
        filters.add(dept);
        filters.add(type);
        filters.add(export);

        JPanel top = new JPanel(new BorderLayout(0, 10));
        top.setOpaque(false);
        top.add(metrics, BorderLayout.NORTH);
        top.add(filters, BorderLayout.SOUTH);

        // Table
        String[] cols = {
            "Select",
            "Asset ID",
            "Equipment",
            "Type",
            "Assigned To",
            "Department",
            "Date Assigned",
            "Due Date",
            "Risk",
            "Status"
        };

        model = new DefaultTableModel(cols, 0) {

            public Class<?> getColumnClass(int c) {
                return c == 0 ? Boolean.class : String.class;
            }

            public boolean isCellEditable(int r, int c) {
                return c == 0;
            }
        };

        for (TridentSupport.Asset a : TridentSupport.byStatus("Assigned")) {
            model.addRow(new Object[]{
                false,
                a.id,
                a.name,
                a.type,
                a.employee,
                a.department,
                "Aug 20, 2026",
                a.due,
                a.risk,
                "Assigned"
            });
        }

        table = new JTable(model);
        table.setRowHeight(55);
        table.setFont(new Font("SansSerif", Font.PLAIN, 14));
        table.setShowGrid(false);
        table.setSelectionBackground(new Color(220, 235, 255));
        table.setSelectionForeground(Color.BLACK);

        table.getTableHeader().setFont(
            new Font("SansSerif", Font.BOLD, 14)
        );
        table.getTableHeader().setPreferredSize(new Dimension(0, 45));

        table.getColumnModel().getColumn(0).setMaxWidth(55);

        JScrollPane scroll = new JScrollPane(table);
        scroll.setBorder(
            BorderFactory.createLineBorder(new Color(220, 225, 230))
        );

        // Actions
        JPanel actions = new JPanel(
            new FlowLayout(FlowLayout.LEFT, 8, 0)
        );
        actions.setOpaque(false);

        JButton remind = createButton("Send Overdue Reminders", true);
        JButton returned = createButton("Bulk Return Selected", false);
        JButton damaged = createButton("Mark Damaged / Lost", false);
        JButton risk = createButton("Adjust Risk", false);

        actions.add(remind);
        actions.add(returned);
        actions.add(damaged);
        actions.add(risk);

        // Assemble Body
        body.add(top, BorderLayout.NORTH);
        body.add(scroll, BorderLayout.CENTER);
        body.add(actions, BorderLayout.SOUTH);

        add(body, BorderLayout.CENTER);

        // Filtering
        Runnable filter = () -> {

            TableRowSorter<DefaultTableModel> s =
                new TableRowSorter<>(model);

            table.setRowSorter(s);

            java.util.List<RowFilter<Object, Object>> fs =
                new ArrayList<>();

            String q = search.getText().trim();

            if (!q.isEmpty()) {
                fs.add(RowFilter.regexFilter(
                    "(?i)" + java.util.regex.Pattern.quote(q)
                ));
            }

            if (dept.getSelectedIndex() > 0) {
                fs.add(RowFilter.regexFilter(
                    "^" + dept.getSelectedItem() + "$", 5
                ));
            }

            if (type.getSelectedIndex() > 0) {
                fs.add(RowFilter.regexFilter(
                    "^" + type.getSelectedItem() + "$", 3
                ));
            }

            s.setRowFilter(
                fs.isEmpty() ? null : RowFilter.andFilter(fs)
            );
        };

        search.getDocument().addDocumentListener(
            new DocumentListener() {

                public void insertUpdate(DocumentEvent e) {
                    filter.run();
                }

                public void removeUpdate(DocumentEvent e) {
                    filter.run();
                }

                public void changedUpdate(DocumentEvent e) {
                    filter.run();
                }
            }
        );

        dept.addActionListener(e -> filter.run());
        type.addActionListener(e -> filter.run());

        // Export
        export.addActionListener(e -> exportTable());

        // Reminders
        remind.addActionListener(e -> {
            JOptionPane.showMessageDialog(
                this,
                "Reminder preview: 5 overdue users selected.\nConnect this button to your organization’s approved email service."
            );
        });

        // Bulk Return and Damage
        returned.addActionListener(
            e -> changeSelectedStatus("Available")
        );

        damaged.addActionListener(
            e -> changeSelectedStatus("Maintenance")
        );

        // Risk Adjustment
        risk.addActionListener(e -> {

            int r = table.getSelectedRow();

            if (r < 0) {
                JOptionPane.showMessageDialog(
                    this,
                    "Select an asset to adjust its risk."
                );
                return;
            }

            int mr = table.convertRowIndexToModel(r);

            String[] levels = {"Low", "Medium", "High"};

            String selected = (String) JOptionPane.showInputDialog(
                this,
                "Set risk level:",
                "Manual risk override",
                JOptionPane.PLAIN_MESSAGE,
                null,
                levels,
                model.getValueAt(mr, 8)
            );

            if (selected != null) {

                model.setValueAt(selected, mr, 8);

                String id = String.valueOf(model.getValueAt(mr, 1));
                TridentSupport.Asset a = TridentSupport.find(id);

                if (a != null) {
                    a.risk = selected;
                }
            }
        });
    }

    // Metric Cards
    private JPanel metric(String label, String value) {

        JPanel p = new JPanel(new BorderLayout(0, 8));
        p.setBackground(Color.WHITE);
        p.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(new Color(225, 230, 235)),
            BorderFactory.createEmptyBorder(15, 15, 15, 15)
        ));

        JLabel l = new JLabel(label);
        l.setForeground(new Color(100, 110, 120));

        JLabel v = new JLabel(value);
        v.setFont(new Font("SansSerif", Font.BOLD, 22));

        p.add(l, BorderLayout.NORTH);
        p.add(v, BorderLayout.CENTER);

        return p;
    }

    // Button Styling
    private JButton createButton(String text, boolean primary) {

        JButton button = new JButton(text);

        button.setFont(new Font("SansSerif", Font.BOLD, 13));
        button.setFocusPainted(false);
        button.setCursor(new Cursor(Cursor.HAND_CURSOR));
        button.setBorder(BorderFactory.createEmptyBorder(10, 15, 10, 15));

        if (primary) {
            button.setBackground(new Color(35, 90, 160));
            button.setForeground(Color.WHITE);
        } else {
            button.setBackground(Color.WHITE);
            button.setForeground(new Color(50, 60, 70));
            button.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(new Color(210, 215, 220)),
                BorderFactory.createEmptyBorder(9, 14, 9, 14)
            ));
        }

        return button;
    }

    // CSV Export
    private void exportTable() {

        JFileChooser chooser = new JFileChooser();
        chooser.setSelectedFile(
            new java.io.File("active_equipment.csv")
        );

        if (chooser.showSaveDialog(this) == JFileChooser.APPROVE_OPTION) {

            try (java.io.PrintWriter writer = new java.io.PrintWriter(
                chooser.getSelectedFile()
            )) {

                for (int c = 0; c < table.getColumnCount(); c++) {
                    writer.print(table.getColumnName(c));

                    if (c < table.getColumnCount() - 1) {
                        writer.print(",");
                    }
                }

                writer.println();

                for (int r = 0; r < table.getRowCount(); r++) {

                    for (int c = 0; c < table.getColumnCount(); c++) {

                        String value = String.valueOf(
                            table.getValueAt(r, c)
                        );

                        writer.print("\"" + value.replace("\"", "\"\"") + "\"");

                        if (c < table.getColumnCount() - 1) {
                            writer.print(",");
                        }
                    }

                    writer.println();
                }

                JOptionPane.showMessageDialog(
                    this,
                    "CSV exported successfully."
                );

            } catch (java.io.IOException ex) {
                JOptionPane.showMessageDialog(
                    this,
                    "Error exporting CSV: " + ex.getMessage()
                );
            }
        }
    }

    // Change Selected Equipment Status
    private void changeSelectedStatus(String status) {

        int count = 0;

        for (int r = 0; r < table.getRowCount(); r++) {

            int mr = table.convertRowIndexToModel(r);

            if (Boolean.TRUE.equals(model.getValueAt(mr, 0))) {

                String id = String.valueOf(model.getValueAt(mr, 1));
                TridentSupport.Asset a = TridentSupport.find(id);

                if (a != null) {
                    a.status = status;
                    a.employee = "";
                    count++;
                }
            }
        }

        if (count == 0) {

            JOptionPane.showMessageDialog(
                this,
                "Select at least one asset."
            );

        } else {

            JOptionPane.showMessageDialog(
                this,
                count + " asset(s) moved to " + status +
                ". Refresh the inventory views to see the change."
            );
        }
    }
}
