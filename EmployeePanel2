import java.awt.;
import java.awt.event.;
import javax.swing.;
import javax.swing.border.Border;
import javax.swing.event.DocumentEvent;
import javax.swing.event.DocumentListener;
import javax.swing.table.;

public class EmployeesPanel extends JPanel {

private static final Color BG_MAIN = new Color(245, 247, 250);
private static final Color CARD_BG = Color.WHITE;
private static final Color BORDER_LIGHT = new Color(220, 225, 230);
private static final Color PRIMARY_BLUE = new Color(35, 90, 160);
private static final Color TEXT_DARK = new Color(30, 38, 48);
private static final Color TEXT_MUTED = new Color(100, 110, 120);

private DefaultTableModel employeeModel;
private JTable employeeTable;

public EmployeesPanel() {
    this(null);
}

public EmployeesPanel(Runnable backCallback) {
    setBackground(BG_MAIN);
    setLayout(new BorderLayout(0, 18));
    setBorder(BorderFactory.createEmptyBorder(35, 40, 35, 40));

    // Header Panel
    JPanel header = new JPanel(new BorderLayout());
    header.setOpaque(false);

    JPanel titlePanel = new JPanel();
    titlePanel.setOpaque(false);
    titlePanel.setLayout(new BoxLayout(titlePanel, BoxLayout.Y_AXIS));

    JLabel title = new JLabel("Employees");
    title.setFont(new Font("SansSerif", Font.BOLD, 28));
    title.setForeground(TEXT_DARK);

    JLabel description = new JLabel("Manage employee records, department assignments, and active equipment custody.");
    description.setForeground(TEXT_MUTED);
    description.setFont(new Font("SansSerif", Font.PLAIN, 14));

    titlePanel.add(title);
    titlePanel.add(Box.createVerticalStrut(4));
    titlePanel.add(description);
    header.add(titlePanel, BorderLayout.WEST);

    // Header Actions
    JPanel actionPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT, 8, 0));
    actionPanel.setOpaque(false);

    if (backCallback != null) {
        JButton backBtn = createButton("Back to Dashboard", false);
        backBtn.addActionListener(e -> backCallback.run());
        actionPanel.add(backBtn);
    }

    JButton addEmpBtn = createButton("+ Add Employee", true);
    addEmpBtn.addActionListener(e -> openAddEmployeeDialog());
    actionPanel.add(addEmpBtn);

    header.add(actionPanel, BorderLayout.EAST);
    add(header, BorderLayout.NORTH);

    // Center Body Card (Search + Table)
    JPanel centerCard = new JPanel(new BorderLayout(0, 12));
    centerCard.setBackground(CARD_BG);
    centerCard.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(BORDER_LIGHT),
            BorderFactory.createEmptyBorder(16, 18, 16, 18)
    ));

    // Search Bar
    JPanel searchPanel = new JPanel(new BorderLayout(8, 0));
    searchPanel.setOpaque(false);
    JTextField searchField = new JTextField();
    searchField.setFont(new Font("SansSerif", Font.PLAIN, 14));
    searchField.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(new Color(210, 215, 220)),
            BorderFactory.createEmptyBorder(8, 12, 8, 12)
    ));
    searchField.setToolTipText("Filter by name, ID, department, or email");
    searchPanel.add(new JLabel("Search Employees: "), BorderLayout.WEST);
    searchPanel.add(searchField, BorderLayout.CENTER);

    // Table Columns as requested
    String[] columns = {
        "Employee ID",
        "Name",
        "Department",
        "Email",
        "Items Checked Out"
    };

    employeeModel = new DefaultTableModel(columns, 0) {
        @Override
        public boolean isCellEditable(int r, int c) {
            return false;
        }
    };

    seedData();

    employeeTable = new JTable(employeeModel);
    employeeTable.setRowHeight(50);
    employeeTable.setFont(new Font("SansSerif", Font.PLAIN, 13));
    employeeTable.setShowGrid(false);
    employeeTable.setSelectionBackground(new Color(220, 235, 255));
    employeeTable.setSelectionForeground(Color.BLACK);
    employeeTable.getTableHeader().setFont(new Font("SansSerif", Font.BOLD, 13));
    employeeTable.getTableHeader().setPreferredSize(new Dimension(0, 40));

    employeeTable.getColumnModel().getColumn(0).setPreferredWidth(90);
    employeeTable.getColumnModel().getColumn(1).setPreferredWidth(140);
    employeeTable.getColumnModel().getColumn(2).setPreferredWidth(100);
    employeeTable.getColumnModel().getColumn(3).setPreferredWidth(180);
    employeeTable.getColumnModel().getColumn(4).setPreferredWidth(260);

    JScrollPane scrollPane = new JScrollPane(employeeTable);
    scrollPane.setBorder(BorderFactory.createLineBorder(BORDER_LIGHT));

    centerCard.add(searchPanel, BorderLayout.NORTH);
    centerCard.add(scrollPane, BorderLayout.CENTER);
    add(centerCard, BorderLayout.CENTER);

    // Live Filtering Logic
    TableRowSorter<DefaultTableModel> sorter = new TableRowSorter<>(employeeModel);
    employeeTable.setRowSorter(sorter);
    searchField.getDocument().addDocumentListener(new DocumentListener() {
        private void filter() {
            String q = searchField.getText().trim();
            if (q.isEmpty()) {
                sorter.setRowFilter(null);
            } else {
                sorter.setRowFilter(RowFilter.regexFilter("(?i)" + java.util.regex.Pattern.quote(q)));
            }
        }
        public void insertUpdate(DocumentEvent e) { filter(); }
        public void removeUpdate(DocumentEvent e) { filter(); }
        public void changedUpdate(DocumentEvent e) { filter(); }
    });

    // Double-click row listener to inspect equipment details in-line
    employeeTable.addMouseListener(new MouseAdapter() {
        @Override
        public void mouseClicked(MouseEvent e) {
            if (e.getClickCount() == 2) {
                int r = employeeTable.getSelectedRow();
                if (r >= 0) {
                    int mr = employeeTable.convertRowIndexToModel(r);
                    String name = (String) employeeModel.getValueAt(mr, 1);
                    String items = (String) employeeModel.getValueAt(mr, 4);
                    JOptionPane.showMessageDialog(EmployeesPanel.this,
                            "Active Equipment Custody for " + name + ":\n\n• " + items.replace(", ", "\n• "),
                            "Employee Equipment Details",
                            JOptionPane.INFORMATION_MESSAGE);
                }
            }
        }
    });
}

private void seedData() {
    employeeModel.addRow(new Object[]{"EMP-1001", "Sarah Jenkins", "Marketing", "s.jenkins@company.com", "EQP-00104 (MacBook Pro 16\"), EQP-00150 (Mouse)"});
    employeeModel.addRow(new Object[]{"EMP-1002", "Marcus Vance", "Operations", "m.vance@company.com", "EQP-00119 (Dell Latitude 7430)"});
    employeeModel.addRow(new Object[]{"EMP-1003", "Elena Rostova", "Finance", "e.rostova@company.com", "EQP-00138 (HP Monitor 27\")"});
    employeeModel.addRow(new Object[]{"EMP-1004", "David Kim", "Engineering", "d.kim@company.com", "EQP-00151 (ThinkPad X1), EQP-00172 (Dock)"});
    employeeModel.addRow(new Object[]{"EMP-1005", "Amanda Taylor", "HR", "a.taylor@company.com", "None (Clean Record)"});
}

private void openAddEmployeeDialog() {
    JDialog dialog = new JDialog((Frame) SwingUtilities.getWindowAncestor(this), "Add Employee", true);
    dialog.setSize(420, 320);
    dialog.setLocationRelativeTo(this);
    dialog.setLayout(new BorderLayout(10, 10));

    JPanel form = new JPanel(new GridLayout(4, 2, 8, 12));
    form.setBorder(BorderFactory.createEmptyBorder(16, 16, 16, 16));

    JTextField idField = new JTextField("EMP-10" + (employeeModel.getRowCount() + 1));
    JTextField nameField = new JTextField();
    JComboBox<String> deptBox = new JComboBox<>(new String[]{"IT", "Marketing", "Operations", "Finance", "HR", "Engineering"});
    JTextField emailField = new JTextField();

    form.add(new JLabel("Employee ID:")); form.add(idField);
    form.add(new JLabel("Full Name:")); form.add(nameField);
    form.add(new JLabel("Department:")); form.add(deptBox);
    form.add(new JLabel("Email:")); form.add(emailField);

    JButton saveBtn = createButton("Save Employee", true);
    saveBtn.addActionListener(e -> {
        if (nameField.getText().trim().isEmpty()) {
            JOptionPane.showMessageDialog(dialog, "Please enter a name.");
            return;
        }
        employeeModel.addRow(new Object[]{
            idField.getText().trim(),
            nameField.getText().trim(),
            deptBox.getSelectedItem().toString(),
            emailField.getText().trim().isEmpty() ? nameField.getText().toLowerCase().replace(" ", ".") + "@company.com" : emailField.getText().trim(),
            "None"
        });
        dialog.dispose();
    });

    dialog.add(form, BorderLayout.CENTER);
    dialog.add(saveBtn, BorderLayout.SOUTH);
    dialog.setVisible(true);
}

private JButton createButton(String text, boolean primary) {
    JButton btn = new JButton(text);
    btn.setFont(new Font("SansSerif", Font.BOLD, 12));
    btn.setFocusPainted(false);
    btn.setCursor(new Cursor(Cursor.HAND_CURSOR));
    if (primary) {
        btn.setBackground(PRIMARY_BLUE);
        btn.setForeground(Color.WHITE);
        btn.setBorder(BorderFactory.createEmptyBorder(9, 14, 9, 14));
    } else {
        btn.setBackground(Color.WHITE);
        btn.setForeground(new Color(50, 60, 70));
        btn.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(new Color(210, 215, 220)),
                BorderFactory.createEmptyBorder(8, 13, 8, 13)
        ));
    }
    return btn;
}
